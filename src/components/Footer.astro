---
import WhatsAppButton from './WhatsAppButton.astro';

const airbnbProfile = 'https://www.airbnb.cl/users/profile/1511006932022722037';
const phone = '5492244420276';
const message = 'Hola! Me gustaría consultar disponibilidad. ¿Tienen disponibilidad para las fechas que estoy buscando? Gracias!';
const waHref = `https://wa.me/${phone}?text=${encodeURIComponent(message)}`;
---

<footer class="border-t border-border mt-12">
  <div class="mx-auto flex max-w-6xl flex-col sm:flex-row items-center justify-between gap-4 px-4 py-6">
    <div class="flex items-center gap-2">
      <img src="/logo-posada-amarella.webp" alt="Posada Amarella" class="h-7 w-7" />
      <p class="font-heading font-semibold">Posada Amarella</p>
    </div>
    <div class="flex items-center gap-2">
      <a href={waHref} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-lg bg-accent px-4 py-2 font-medium text-[#1a1a1a] hover:opacity-90 transition-opacity">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
        </svg>
        Consultar por WhatsApp
      </a>
      <a href={airbnbProfile} target="_blank" rel="noopener noreferrer" aria-label="Airbnb perfil" class="inline-flex items-center justify-center rounded-lg border border-border p-2 hover:bg-bg-subtle transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 0C5.372 0 0 5.373 0 12s5.372 12 12 12 12-5.373 12-12S18.628 0 12 0zm0 19.2c-3.978 0-7.2-3.222-7.2-7.2S8.022 4.8 12 4.8s7.2 3.222 7.2 7.2-3.222 7.2-7.2 7.2zm0-11.4a4.2 4.2 0 100 8.4 4.2 4.2 0 000-8.4z"/>
        </svg>
      </a>
    </div>
  </div>
</footer>
