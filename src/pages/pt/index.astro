  3: 'Um cantinho aconchegante com todos os detalhes para você se sentir em casa.',
  4: 'Ideal para casais que procuram privacidade, calma e uma boa noite de sono.',
};
---

<BaseLayout title="Posada Amarella" description="Posada Amarella - Consulte disponibilidade pelo WhatsApp ou Airbnb.">
  <Header />
  <main>
    <section id="inicio" class="scroll-mt-0">
      <div class="pt-[60px] sm:pt-6 lg:pt-8">
        <div class="relative w-full overflow-hidden">
          <div class="mx-auto max-w-[1440px] px-0 sm:px-4 lg:px-6">
            <div class="relative aspect-[16/10] w-full overflow-hidden sm:aspect-[21/9] sm:rounded-3xl sm:border sm:border-border/60 sm:shadow-lg h-[calc(100svh-60px)] max-h-[560px] sm:h-auto sm:max-h-none">
              <img
                src={commonImages[0]}
                alt="Posada Amarella - foto principal"
                class="absolute inset-0 h-full w-full object-cover sm:hidden"
                loading="eager"
                decoding="async"
              />
              <div class="absolute inset-0 hidden sm:grid grid-cols-[2fr_1fr] grid-rows-2 gap-[1px] lg:grid-cols-[2fr_1fr_1fr] lg:gap-[2px]">
                {commonImages.slice(0, 5).map((src, index) => (
                  <div
                    class:list={[
                      "group relative h-full w-full overflow-hidden",
                      index === 0 && "col-start-1 row-start-1 row-span-2",
                      index === 1 && "col-start-2 row-start-1",
                      index === 2 && "col-start-2 row-start-2",
                      index === 3 && "hidden lg:block lg:col-start-3 lg:row-start-1",
                      index === 4 && "hidden lg:block lg:col-start-3 lg:row-start-2",
                    ]}
                  >
                    <img
                      src={src}
                      alt={`Áreas comuns da Posada Amarella - foto ${index + 1}`}
                      class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                      loading={index === 0 ? "eager" : "lazy"}
                      decoding="async"
                    />
                  </div>
                ))}
              </div>

              <div class="absolute inset-0 bg-gradient-to-t from-black/95 via-black/30 to-transparent"></div>

              <div class="absolute bottom-0 left-0 flex flex-col gap-2 p-4 sm:p-8 lg:p-10">
                <p class="text-xs uppercase tracking-[0.4em] text-white/70 sm:text-sm">Posada Amarella</p>
                <h1 class="text-3xl font-heading font-bold text-white sm:text-4xl md:text-5xl lg:text-6xl">Descanso, calma e aconchego</h1>
                <p class="max-w-2xl text-base text-white/90 sm:text-lg">
                  Um espaço tranquilo para descansar, em meio à natureza. Pátio, cozinha completa compartilhada e sala para aproveitar no seu ritmo.
                </p>
                <div class="mt-2 flex flex-col gap-2 sm:flex-row">
                  <WhatsAppButton label="Consultar pelo WhatsApp" />
                  <a
                    href={airbnbProfile}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center justify-center rounded-lg border border-white/40 bg-white/10 px-4 py-2 text-white backdrop-blur transition-colors hover:bg-white/20"
                  >
                    Ver perfil no Airbnb
                  </a>
                </div>
              </div>

              {commonImages.length > 3 && (
                <div class="pointer-events-none absolute bottom-0 right-0 m-4 rounded-full bg-black/60 px-3 py-1 text-xs text-white/90 backdrop-blur sm:m-6 lg:m-8">
  
                </div>
              )}
            </div>
          </div>
        </div>
      </div>

      <div class="mx-auto max-w-6xl px-4 py-10 sm:py-14 lg:py-16">
        <div class="max-w-3xl">
          <h2 class="text-2xl sm:text-3xl md:text-4xl font-heading font-semibold mb-4">A Pousada</h2>
          <p class="text-base sm:text-lg text-text-secondary leading-relaxed">A Posada Amarella recebe você com carinho em um ambiente simples e aconchegante. Pensada para que você descanse e aproveite sua estadia com tranquilidade. Contamos com 4 suítes equipadas e áreas comuns compartilhadas para que você se sinta em casa.</p>
        </div>
      </div>
    </section>

    <div class="mx-auto max-w-6xl px-4 flex flex-col gap-4 sm:gap-6 pb-10 sm:pb-14">
      {rooms.map((room) => (
        <SuiteSection
          suiteNumber={room.suite}
          id={`suite-${room.suite}`}
          airbnbUrl={room.url}
          images={suiteImages[room.suite as keyof typeof suiteImages]}
          subtitle={suiteSubtitles[room.suite as keyof typeof suiteSubtitles]}
        />
      ))}
    </div>
  </main>
  <Footer />
</BaseLayout>
