---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SuiteSection from '../../components/SuiteSection.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';

const rooms = [
  { suite: 1, url: 'https://www.airbnb.cl/rooms/16400765?guests=1&adults=1&s=67&unique_share_id=abcba998-e8d2-41b2-9dc7-b5c4c4f1c439' },
  { suite: 2, url: 'https://www.airbnb.cl/rooms/15752700?guests=1&adults=1&s=67&unique_share_id=f2d812a9-aeb0-4934-92cc-c5c50a05dc15' },
  { suite: 3, url: 'https://www.airbnb.cl/rooms/15662395?guests=1&adults=1&s=67&unique_share_id=21444c39-e2f9-452e-bc59-6464ddb89504' },
  { suite: 4, url: 'https://www.airbnb.cl/rooms/1511006931361974988?guests=1&adults=1&s=67&unique_share_id=198e2ba0-8c90-4d9b-bb14-dd0cd0d42e65' },
];

const airbnbProfile = 'https://www.airbnb.cl/users/profile/1511006932022722037';

const commonImages = [
  '/assets/patio-01.avif',
  '/assets/cocina-completa-compartida-01.avif',
  '/assets/sala-01.avif',
  '/assets/patio-02.avif',
  '/assets/cocina-completa-compartida-02.avif',
];

const suiteImages = {
  1: [
    '/assets/habitacion-01/habitacion-01.avif',
    '/assets/habitacion-01/habitacion-02.avif',
    '/assets/habitacion-01/habitacion-03.avif',
    '/assets/habitacion-01/habitacion-04.avif',
    '/assets/habitacion-01/bano-01.avif',
  ],
  2: [
    '/assets/habitacion-02/habitacion-01.avif',
    '/assets/habitacion-02/habitacion-02.avif',
    '/assets/habitacion-02/habitacion-03.avif',
    '/assets/habitacion-02/habitacion-04.avif',
    '/assets/habitacion-02/bano-01.avif',
  ],
  3: [
    '/assets/habitacion-03/habitacion-01.avif',
    '/assets/habitacion-03/habitacion-02.avif',
    '/assets/habitacion-03/habitacion-03.avif',
    '/assets/habitacion-03/habitacion-04.avif',
    '/assets/habitacion-03/bano-01.avif',
  ],
  4: [
    '/assets/habitacion-04/habitacion-01.avif',
    '/assets/habitacion-04/habitacion-02.avif',
    '/assets/habitacion-04/habitacion-03.avif',
    '/assets/habitacion-04/habitacion-04.avif',
    '/assets/habitacion-04/bano-01.avif',
  ],
};

const suiteSubtitles = {
  1: 'Private suite with warm ambiance, ideal for relaxing after a day exploring the valley.',
  2: 'Spacious, bright, and designed for a quiet and comfortable stay.',
  3: 'A cozy corner with all the details to make you feel right at home.',
  4: 'Ideal for couples looking for privacy, calm, and a restful night.',
};
---

<BaseLayout title="Posada Amarella" description="Posada Amarella - Check availability by WhatsApp or Airbnb.">
  <Header />
  <main>
    <section id="inicio" class="scroll-mt-0">
      <div class="pt-16 sm:pt-6 lg:pt-8">
        <div class="relative w-full overflow-hidden">
          <div class="mx-auto max-w-[1440px] px-0 sm:px-4 lg:px-6">
            <div class="relative aspect-[16/10] w-full overflow-hidden sm:aspect-[21/9] sm:rounded-3xl sm:border sm:border-border/60 sm:shadow-lg">
              <div class="absolute inset-0 grid grid-cols-[2fr_1fr] grid-rows-2 gap-[1px] lg:grid-cols-[2fr_1fr_1fr] lg:gap-[2px]">
                {commonImages.slice(0, 5).map((src, index) => (
                  <div
                    class:list={[
                      "group relative h-full w-full overflow-hidden",
                      index === 0 && "col-start-1 row-start-1 row-span-2",
                      index === 1 && "col-start-2 row-start-1",
                      index === 2 && "col-start-2 row-start-2",
                      index === 3 && "hidden lg:block lg:col-start-3 lg:row-start-1",
                      index === 4 && "hidden lg:block lg:col-start-3 lg:row-start-2",
                    ]}
                  >
                    <img
                      src={src}
                      alt={`Common areas of Posada Amarella - photo ${index + 1}`}
                      class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                      loading={index === 0 ? "eager" : "lazy"}
                      decoding="async"
                    />
                  </div>
                ))}
              </div>

              <div class="absolute inset-0 bg-gradient-to-t from-black/95 via-black/30 to-transparent"></div>

              <div class="absolute bottom-0 left-0 flex flex-col gap-2 p-4 sm:p-8 lg:p-10">
                <p class="text-xs uppercase tracking-[0.4em] text-white/70 sm:text-sm">Posada Amarella</p>
                <h1 class="text-3xl font-heading font-bold text-white sm:text-4xl md:text-5xl lg:text-6xl">Rest, calm and warmth</h1>
                <p class="max-w-2xl text-base text-white/90 sm:text-lg">
                  A quiet space to rest, surrounded by nature. Patio, fully equipped shared kitchen and living room to enjoy at your pace.
                </p>
                <div class="mt-2 flex flex-col gap-2 sm:flex-row">
                  <WhatsAppButton label="Inquire via WhatsApp" />
                  <a
                    href={airbnbProfile}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center justify-center rounded-lg border border-white/40 bg-white/10 px-4 py-2 text-white backdrop-blur transition-colors hover:bg-white/20"
                  >
                    View Airbnb profile
                  </a>
                </div>
              </div>

              {commonImages.length > 3 && (
                <div class="pointer-events-none absolute bottom-0 right-0 m-4 rounded-full bg-black/60 px-3 py-1 text-xs text-white/90 backdrop-blur sm:m-6 lg:m-8">
                  {commonImages.length > 5 ? `+${commonImages.length - 5} photos` : `+${commonImages.length - 3} photos`}
                </div>
              )}
            </div>
          </div>
        </div>
      </div>

      <div class="mx-auto max-w-6xl px-4 py-10 sm:py-14 lg:py-16">
        <div class="max-w-3xl">
          <h2 class="text-2xl sm:text-3xl md:text-4xl font-heading font-semibold mb-4">The Inn</h2>
          <p class="text-base sm:text-lg text-text-secondary leading-relaxed">Posada Amarella welcomes you with warmth in a simple and comfortable setting. Designed for you to rest and enjoy your stay in peace and quiet. We have 4 fully equipped suites and shared common areas to make you feel right at home.</p>
        </div>
      </div>
    </section>

    <div class="mx-auto max-w-6xl px-4 flex flex-col gap-4 sm:gap-6 pb-10 sm:pb-14">
      {rooms.map((room) => (
        <SuiteSection
          suiteNumber={room.suite}
          id={`suite-${room.suite}`}
          airbnbUrl={room.url}
          images={suiteImages[room.suite as keyof typeof suiteImages]}
          subtitle={suiteSubtitles[room.suite as keyof typeof suiteSubtitles]}
        />
      ))}
    </div>
  </main>
  <Footer />
</BaseLayout>
