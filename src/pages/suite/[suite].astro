---
import BaseLayout from '../../layouts/BaseLayout.astro';
import fs from 'node:fs';
import path from 'node:path';

export function getStaticPaths() {
  return [
    { params: { suite: '1' } },
    { params: { suite: '2' } },
    { params: { suite: '3' } },
    { params: { suite: '4' } },
  ];
}

const { suite } = Astro.params;
const suiteNumber = Number(suite);

const getImages = (dir: string) => {
  const full = path.join(process.cwd(), 'public', dir);
  try {
    return fs
      .readdirSync(full)
      .filter((f) => f.endsWith('.avif') || f.endsWith('.jpg') || f.endsWith('.png') || f.endsWith('.webp'))
      .sort()
      .map((f) => `/${dir}/${f}`);
  } catch {
    return [];
  }
};

const suiteDir = `assets/habitacion-0${suiteNumber}`;
const suiteImages = getImages(suiteDir);
const patioImages = getImages('assets').filter((f) => f.includes('/assets/patio-'));
const cocinaImages = getImages('assets').filter((f) => f.includes('/assets/cocina-'));
const salaImages = getImages('assets').filter((f) => f.includes('/assets/sala-'));

const habitacionImages = suiteImages.filter((f) => f.toLowerCase().includes('habitacion-'));
const banoImages = suiteImages.filter((f) => f.toLowerCase().includes('bano'));

const allImages = [...habitacionImages, ...banoImages, ...patioImages, ...cocinaImages, ...salaImages];

const getGroup = (src: string) => {
  const s = src.toLowerCase();
  if (s.includes('bano') || s.includes('baño')) return { key: 'bano', label: 'Baño' };
  if (s.includes('habitacion')) return { key: 'habitacion', label: 'Habitación' };
  if (s.includes('patio')) return { key: 'patio', label: 'Patio' };
  if (s.includes('cocina')) return { key: 'cocina', label: 'Cocina' };
  if (s.includes('sala') || s.includes('salon') || s.includes('salón')) return { key: 'salon', label: 'Salón' };
  return { key: 'otros', label: 'Otros' };
};

const order = ['habitacion', 'bano', 'patio', 'cocina', 'salon', 'otros'];

const groups = allImages.reduce(
  (acc, src) => {
    const g = getGroup(src);
    if (!acc[g.key]) {
      acc[g.key] = { label: g.label, images: [] as string[] };
    }
    acc[g.key].images.push(src);
    return acc;
  },
  {} as Record<string, { label: string; images: string[] }>
);

const grouped = order
  .filter((key) => groups[key] && groups[key].images.length > 0)
  .map((key) => groups[key]);

const roomName = `Suite ${suiteNumber}`;
---
<BaseLayout title={`${roomName} - Posada Amarella`} description={`${roomName} - Galería completa`}>
  <main class="min-h-screen bg-bg">
    <header class="sticky top-0 z-30 border-b border-border bg-bg/80 backdrop-blur">
      <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3">
        <a href="/#suite-${suiteNumber}" class="inline-flex items-center gap-2 text-sm hover:text-accent transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
          Volver al listado
        </a>
        <p class="font-heading font-semibold">{roomName}</p>
        <div class="w-24"></div>
      </div>
    </header>

    <section class="mx-auto max-w-7xl px-4 py-6 sm:py-10">
      <div class="flex flex-col gap-10">
        {grouped.map((group, gIdx) => (
          <div class="flex flex-col gap-4">
            <h2 class="text-xl sm:text-2xl font-heading font-semibold">{group.label}</h2>
            <div class="grid gap-2 sm:gap-3 grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
              {group.images.map((src, idx) => (
                <button
                  type="button"
                  class:list={[
                    "overflow-hidden rounded-xl border border-border bg-bg-subtle text-left",
                    idx === 0 && group.key === 'habitacion' && group.images.length >= 2 && "md:col-span-2 md:row-span-2",
                  ]}
                  data-lightbox-open
                  data-lightbox-src={src}
                  aria-label="Ampliar imagen"
                >
                  <img
                    src={src}
                    alt={`${roomName} - ${group.label.toLowerCase()}`}
                    class="h-full w-full object-cover aspect-square md:aspect-auto"
                    loading={gIdx === 0 && idx < 4 ? "eager" : "lazy"}
                    decoding="async"
                  />
                </button>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>
  </main>

  <div id="gallery-lightbox" class="fixed inset-0 z-[100] hidden">
    <div id="gallery-lightbox-backdrop" class="absolute inset-0 bg-black/95"></div>
    <button id="gallery-lightbox-close" class="absolute top-4 right-4 z-10 inline-flex items-center justify-center rounded-full p-2 text-white hover:bg-white/10" aria-label="Cerrar">
      <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
    <button id="gallery-lightbox-prev" class="absolute left-2 sm:left-4 top-1/2 -translate-y-1/2 z-10 inline-flex items-center justify-center rounded-full p-2 text-white hover:bg-white/10" aria-label="Anterior">
      <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
    </button>
    <button id="gallery-lightbox-next" class="absolute right-2 sm:right-4 top-1/2 -translate-y-1/2 z-10 inline-flex items-center justify-center rounded-full p-2 text-white hover:bg-white/10" aria-label="Siguiente">
      <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="9 18 15 12 9 6"></polyline>
      </svg>
    </button>
    <div class="relative h-full w-full flex items-center justify-center p-4 sm:p-10">
      <img id="gallery-lightbox-image" src="" alt="" class="max-h-[90vh] max-w-[90vw] object-contain" />
    </div>
  </div>

  <script is:inline>
    const lightbox = document.getElementById('gallery-lightbox');
    const lightboxImg = document.getElementById('gallery-lightbox-image');
    const closeBtn = document.getElementById('gallery-lightbox-close');
    const prevBtn = document.getElementById('gallery-lightbox-prev');
    const nextBtn = document.getElementById('gallery-lightbox-next');
    const backdrop = document.getElementById('gallery-lightbox-backdrop');
    const triggers = Array.from(document.querySelectorAll('[data-lightbox-open]'));
    const images = triggers.map((t) => t.getAttribute('data-lightbox-src')).filter(Boolean);
    let index = 0;

    const open = (i) => {
      index = i;
      if (!images[index]) return;
      lightboxImg.src = images[index];
      lightbox.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    };

    const close = () => {
      lightbox.classList.add('hidden');
      document.body.style.overflow = '';
    };

    const prev = () => open((index - 1 + images.length) % images.length);
    const next = () => open((index + 1) % images.length);

    triggers.forEach((t, i) => t.addEventListener('click', () => open(i)));
    closeBtn?.addEventListener('click', close);
    backdrop?.addEventListener('click', close);
    prevBtn?.addEventListener('click', prev);
    nextBtn?.addEventListener('click', next);

    window.addEventListener('keydown', (e) => {
      if (lightbox.classList.contains('hidden')) {
        if (e.key === 'Escape') {
          const back = document.querySelector('a[href^="/#suite-"]');
          if (back) back.click();
          else history.back();
        }
        return;
      }
      if (e.key === 'Escape') close();
      if (e.key === 'ArrowLeft') prev();
      if (e.key === 'ArrowRight') next();
    });
  </script>
</BaseLayout>
